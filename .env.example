# Frontend configuration. Copy to .env.local and adjust.
# Change the backend location here, never in the code.

# Base URL of the Python (FastAPI) backend, including its API prefix.
NEXT_PUBLIC_API_URL=http://localhost:8000/api

# Endpoint paths, relative to NEXT_PUBLIC_API_URL.
NEXT_PUBLIC_API_HEALTH_PATH=/health
NEXT_PUBLIC_API_STRATEGIES_PATH=/strategies
NEXT_PUBLIC_API_TRADES_PATH=/trades
